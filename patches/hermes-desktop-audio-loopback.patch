+// ─── Local patch (2026-09-12): system-audio loopback for audio-visualizer ───
+// Codex-style "audio visualization": the renderer's AnalyserNode rides the
+// system output via Chromium's loopback audio (Core Audio taps, "Catap" in
+// Chromium 140 — the older MacSck*/MacLoopback* feature names are gone).
+// Known upstream breakage (electron#49607): an audio-only getDisplayMedia
+// request fails with "Error starting capture" on this stack. The documented
+// workaround: the renderer requests a tiny throwaway video track alongside
+// audio, and this handler grants a REAL screen source for the video plus
+// `audio: 'loopback'` for the system output mix. The plugin discards the
+// video track immediately; audio never leaves the process (FFT in RAM only).
+if (process.platform === 'darwin') {
+  app.commandLine.appendSwitch(
+    'enable-features',
+    'MacCatapLoopbackAudioForScreenShare'
+  )
+  // session.defaultSession only exists after the `ready` event — touching it
+  // at module scope throws "Session can only be received when app is ready"
+  // and killed startup (hotfixed 2026-09-12). appendSwitch above must stay
+  // pre-ready; only the handler registration moves into whenReady.
+  void app.whenReady().then(async () => {
+    let primaryScreen
+    try {
+      const sources = await desktopCapturer.getSources({ types: ['screen'] })
+      primaryScreen = sources[0]
+    } catch {
+      primaryScreen = undefined
+    }
+    session.defaultSession.setDisplayMediaRequestHandler(
+      (_request, callback) => {
+        callback({ video: primaryScreen, audio: 'loopback' })
+      },
+      { useSystemPicker: false }
+    )
+  })
+}
+// ─── end local patch ───
